# ==========================================
# Skillo AI Frontend — Environment Configuration
# ==========================================

# Backend Server Target (used by Next.js server-side proxy rewrites)
# Local Development: http://127.0.0.1:8000
# Production: https://skillo-zawx.vercel.app
BACKEND_URL=http://127.0.0.1:8000

# Client-Facing API Base URL (Optional — defaults to same-origin /api/v1 proxy)
# Set only if you want direct cross-origin browser-to-backend communication:
# NEXT_PUBLIC_API_URL=https://skillo-zawx.vercel.app/api/v1

# ==========================================
# Skillo AI — Environment Configuration
# ==========================================

# Server Port & Host (Default: 8000)
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://skillo-ai.vercel.app

# Google Gemini API Key (Optional — enhances dynamic explanations and LLM fallback)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional — fallback classification)
OPENAI_API_KEY=your_openai_api_key_here

# Firebase Admin Firestore Credentials (Optional — falls back to local JSON storage if unset)
# Path to service account JSON or raw JSON string:
# GOOGLE_APPLICATION_CREDENTIALS=backend/firebase-key.json
# FIREBASE_CREDENTIALS_JSON={"type": "service_account", ...}
